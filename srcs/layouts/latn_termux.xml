<?xml version="1.0" encoding="utf-8"?>
<!-- QWERTY layout with terminal-friendly modifiers and raw navigation keys. -->
<keyboard name="Termux Coding" bottom_row="false" script="latin">
  <modmap>
    <fn a="q" b="f1"/>
    <fn a="w" b="f2"/>
    <fn a="e" b="f3"/>
    <fn a="r" b="f4"/>
    <fn a="t" b="f5"/>
    <fn a="y" b="f6"/>
    <fn a="u" b="f7"/>
    <fn a="i" b="f8"/>
    <fn a="o" b="f9"/>
    <fn a="p" b="f10"/>
    <fn a="a" b="f11"/>
    <fn a="s" b="f12"/>
  </modmap>

  <!-- Termux navigation row -->
  <row scale="7.0" height="1.0">
    <key c="ESC:esc"/>
    <key c="/:'/'"/>
    <key c="-:'-'"/>
    <key c="HOME:home"/>
    <key c="↑:up"/>
    <key c="END:end"/>
    <key c="PGUP:page_up"/>
  </row>

  <!-- Termux control row -->
  <row scale="7.0" height="1.0">
    <key c="TAB:tab"/>
    <key c="CTRL:ctrl"/>
    <key c="ALT:alt"/>
    <key c="←:left"/>
    <key c="↓:down"/>
    <key c="→:right"/>
    <key c="PGDN:page_down"/>
  </row>

  <!-- Termux programming symbols row -->
  <row scale="10.0" height="1.0">
    <key c="!:'!'"/>
    <key c="@:'@'"/>
    <key c="#:'#'"/>
    <key c="$:'$'"/>
    <key c="%:'%'"/>
    <key c="^:'^'"/>
    <key c="&amp;:'&amp;'"/>
    <key c="*:'*'"/>
    <key c="(:'('"/>
    <key c="):')'"/>
  </row>

  <row>
    <key c="q" ne="1" se="!" nw="loc esc"/>
    <key c="w" ne="2" sw="@"/>
    <key c="e" ne="3" sw="#"/>
    <key c="r" ne="4" sw="$"/>
    <key c="t" ne="5" sw="%"/>
    <key c="y" ne="6" sw="^"/>
    <key c="u" ne="7" sw="&amp;"/>
    <key c="i" ne="8" sw="*"/>
    <key c="o" ne="9" sw="("/>
    <key c="p" ne="0" sw=")"/>
  </row>
  <row scale="10.0">
    <key c="a" nw="loc tab" ne="`" sw="?"/>
    <key c="s" ne="~" sw="&quot;"/>
    <key c="d" ne="-" sw="'"/>
    <key c="f" ne="_" sw=":"/>
    <key c="g" ne="+" sw=","/>
    <key c="h" ne="=" sw="."/>
    <key c="j" ne="{" sw="["/>
    <key c="k" ne="}" sw="]"/>
    <key c="l" ne="|" sw="\\"/>
  </row>
  <row>
    <key shift="0.0" width="1.5" role="action" c="shift" ne="loc capslock"/>
    <key c="z"/>
    <key c="x"/>
    <key c="c" ne="&lt;"/>
    <key c="v" ne="&gt;"/>
    <key c="b"/>
    <key c="n" ne="/"/>
    <key c="m" ne=";"/>
    <key width="1.5" role="action" c="backspace" ne="delete"/>
  </row>
  <row height="0.95">
    <key width="1.0" role="action" c="ctrl" key1="loc switch_greekmath" key2="loc meta" key3="loc switch_clipboard" key4="switch_numeric"/>
    <key width="1.0" role="action" c="alt" key1="loc alt" key2="loc change_method" key5="fn"/>
    <key width="0.9" role="action" c="esc"/>
    <key width="0.9" role="action" c="tab"/>
    <key width="1.0" role="action" c="toggle_language" key4="change_dictionary" key3="switch_emoji"/>
    <key width="2.7" role="space_bar" c="space" key7="switch_forward" key8="switch_backward" key5="cursor_left" key6="cursor_right"/>
    <key width="1.0" role="action" c="loc compose" key7="up" key6="right" key5="left" key8="down" key1="loc home" key2="loc page_up" key3="loc end" key4="config"/>
    <key width="1.5" role="action" c="enter" key1="loc voice_typing" key2="action"/>
  </row>
</keyboard>