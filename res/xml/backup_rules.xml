<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy full-backup (Android < 12) rules.
  Only the Sinhala learner's bigram preferences and default settings are backed up.
  Clipboard pins and emoji usage history are private and are excluded.
  Root, file, database and external storage are never backed up.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="external" path="."/>
    <exclude domain="sharedpref" path="pinned_clipboards.xml"/>
    <exclude domain="sharedpref" path="emoji_last_use.xml"/>
</full-backup-content>
