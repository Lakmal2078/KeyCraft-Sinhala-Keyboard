<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude IME preferences, learned words, dictionary and pinned clipboard content from cloud and D2D transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="device_root" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="device_root" path="."/>
    </device-transfer>
</data-extraction-rules>
