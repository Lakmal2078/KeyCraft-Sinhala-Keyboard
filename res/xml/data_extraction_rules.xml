<?xml version="1.0" encoding="utf-8"?>
<!-- Only the direct-boot settings store is portable; transient and private app data is excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="device_sharedpref" path="com.lakmal.keycraftsinhala_preferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="device_sharedpref" path="com.lakmal.keycraftsinhala_preferences.xml"/>
    </device-transfer>
</data-extraction-rules>
