<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules.
  Mirrors backup_rules.xml. Clipboard pins and emoji usage are excluded for privacy.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="sharedpref" path="pinned_clipboards.xml"/>
        <exclude domain="sharedpref" path="emoji_last_use.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="sharedpref" path="pinned_clipboards.xml"/>
        <exclude domain="sharedpref" path="emoji_last_use.xml"/>
    </device-transfer>
</data-extraction-rules>
