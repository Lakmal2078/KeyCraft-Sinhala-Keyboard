<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/text_edit_pane"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorKeyboard"
    android:padding="8dp">

  <!-- Header row: Select toggle, Select All, Copy, Cut, Paste, Back -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layout_marginBottom="6dp">

    <Button
        android:id="@+id/text_edit_select_toggle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:background="@drawable/suggestions_item_background"
        android:text="@string/text_edit_select"
        android:textColor="?attr/colorLabel"
        android:textAllCaps="false"
        android:textSize="13sp"/>

    <Button
        android:id="@+id/text_edit_select_all"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:background="@drawable/suggestions_item_background"
        android:text="@string/key_descr_selectAll"
        android:textColor="?attr/colorLabel"
        android:textAllCaps="false"
        android:textSize="13sp"/>

    <Button
        android:id="@+id/text_edit_copy"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:background="@drawable/suggestions_item_background"
        android:text="@string/key_descr_copy"
        android:textColor="?attr/colorLabel"
        android:textAllCaps="false"
        android:textSize="13sp"/>

    <Button
        android:id="@+id/text_edit_cut"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:background="@drawable/suggestions_item_background"
        android:text="@string/key_descr_cut"
        android:textColor="?attr/colorLabel"
        android:textAllCaps="false"
        android:textSize="13sp"/>

    <Button
        android:id="@+id/text_edit_paste"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_margin="2dp"
        android:background="@drawable/suggestions_item_background"
        android:text="@string/key_descr_paste"
        android:textColor="?attr/colorLabel"
        android:textAllCaps="false"
        android:textSize="13sp"/>
  </LinearLayout>

  <!-- Main D-pad + Editing Grid -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:baselineAligned="false"
      android:gravity="center_vertical">

    <!-- Left column: Undo / Redo / Home -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

      <Button
          android:id="@+id/text_edit_undo"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_margin="2dp"
          android:background="@drawable/suggestions_item_background"
          android:text="@string/key_descr_undo"
          android:textColor="?attr/colorLabel"
          android:textAllCaps="false"
          android:textSize="13sp"/>

      <Button
          android:id="@+id/text_edit_redo"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_margin="2dp"
          android:background="@drawable/suggestions_item_background"
          android:text="@string/key_descr_redo"
          android:textColor="?attr/colorLabel"
          android:textAllCaps="false"
          android:textSize="13sp"/>

      <Button
          android:id="@+id/text_edit_home"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_margin="2dp"
          android:background="@drawable/suggestions_item_background"
          android:text="@string/key_descr_home"
          android:textColor="?attr/colorLabel"
          android:textAllCaps="false"
          android:textSize="13sp"/>
    </LinearLayout>

    <!-- Center 3x3 D-pad cursor controls -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.2"
        android:orientation="vertical">

      <!-- Up -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center">
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/text_edit_up"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.2"
            android:layout_margin="2dp"
            android:background="@drawable/suggestions_item_background"
            android:src="@drawable/ic_arrow_up"
            android:tint="?attr/colorLabel"
            android:contentDescription="@string/text_edit_cursor_up"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
      </LinearLayout>

      <!-- Left / Center Indicator / Right -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center">
        <Button
            android:id="@+id/text_edit_left"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/suggestions_item_background"
            android:text="@string/text_edit_arrow_left_symbol"
            android:textColor="?attr/colorLabel"
            android:textSize="16sp"
            android:contentDescription="@string/text_edit_cursor_left"/>
        <Button
            android:id="@+id/text_edit_back"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.2"
            android:layout_margin="2dp"
            android:background="@drawable/suggestions_pill_background"
            android:text="@string/text_edit_done"
            android:textColor="?attr/colorLabelActivated"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="13sp"/>
        <Button
            android:id="@+id/text_edit_right"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/suggestions_item_background"
            android:text="@string/text_edit_arrow_right_symbol"
            android:textColor="?attr/colorLabel"
            android:textSize="16sp"
            android:contentDescription="@string/text_edit_cursor_right"/>
      </LinearLayout>

      <!-- Down -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center">
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <ImageButton
            android:id="@+id/text_edit_down"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.2"
            android:layout_margin="2dp"
            android:background="@drawable/suggestions_item_background"
            android:src="@drawable/ic_arrow_down"
            android:tint="?attr/colorLabel"
            android:contentDescription="@string/text_edit_cursor_down"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
      </LinearLayout>
    </LinearLayout>

    <!-- Right column: Word Left/Right / Backspace / End -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

      <Button
          android:id="@+id/text_edit_backspace"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_margin="2dp"
          android:background="@drawable/suggestions_item_background"
          android:text="@string/text_edit_backspace_symbol"
          android:textColor="?attr/colorLabel"
          android:textSize="18sp"
          android:contentDescription="@string/key_descr_backspace"/>

      <Button
          android:id="@+id/text_edit_del_word"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_margin="2dp"
          android:background="@drawable/suggestions_item_background"
          android:text="@string/text_edit_del_word"
          android:textColor="?attr/colorLabel"
          android:textAllCaps="false"
          android:textSize="12sp"/>

      <Button
          android:id="@+id/text_edit_end"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_margin="2dp"
          android:background="@drawable/suggestions_item_background"
          android:text="@string/key_descr_end"
          android:textColor="?attr/colorLabel"
          android:textAllCaps="false"
          android:textSize="13sp"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
